# Turso database credentials (required for database-backed routes and seeding)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Public-demo protection
DEMO_PASSCODE=change-this-before-sharing
STAFF_PASSCODE=use-a-different-long-random-code
DEMO_RATE_LIMIT_MAX=60
DEMO_RATE_LIMIT_WINDOW_MS=60000

# Select one of the bundled profiles
ACTIVE_CLINIC_PROFILE=ph

# Future integrations (safe defaults for the demo)
DRY_RUN=true
APP_BASE_URL=https://your-app.vercel.app
CRON_SECRET=replace-with-a-long-random-secret
SEMAPHORE_SENDER_NAME=
RESEND_FROM_EMAIL=
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
SEMAPHORE_API_KEY=
RESEND_API_KEY=
